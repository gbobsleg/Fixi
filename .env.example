# Copy to .env and adapt. Never commit .env.

# --- Base ---
NODE_ENV=development
PORT=3000
# Public URL of Fixi (used in e-mail links and for the admin CSRF check)
APP_BASE_URL=http://localhost:3000
# true when Fixi runs behind a reverse proxy (real client IP from X-Forwarded-For)
TRUST_PROXY=false
DATABASE_PATH=./data/fixi.db
STORAGE_DIR=./storage
RETENTION_DAYS=90
DISPLAY_TIMEZONE=Europe/Paris

# --- Admin ---
ADMIN_USER=admin
# Generate with: npm run hash-password
# Keep the SINGLE QUOTES: a bcrypt hash contains '$' characters.
ADMIN_PASSWORD_HASH=
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional: receives an e-mail for every new report
ADMIN_ALERT_EMAIL=

# --- GitLab (optional) ---
GITLAB_URL=
GITLAB_TOKEN=

# --- GitHub (optional) ---
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# --- SMTP (optional: without SMTP_HOST, e-mails are only written to the logs) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Fixi <fixi@localhost>
