{
  "name": "fixi",
  "version": "0.1.0",
  "private": true,
  "description": "Service interne de signalement de bugs (widget + backend + admin de triage)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "purge": "node --env-file-if-exists=.env --import tsx scripts/purge.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/view": "^12.0.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "file-type": "^22.3.0",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
